# SignTalk AI .gitignore

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Environments
.env
.venv
venv/
ENV/

# Raw video data (Strict privacy rule: NEVER commit raw human signer video)
data/raw/
data/raw/*
data/external/
dataset/
dataset/*
datasets/

# Interim video and visual artifacts
data/interim/landmark_pilot/*.mp4
data/interim/landmark_pilot/*.gif

# Pre-trained models and heavy weights
models/mediapipe/*.task
models/*.onnx
models/*.pt
models/*.pth

# IDE and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
signtalk_colab.zip

# Local notes (not for the repo)
CONTEXT.md
CHANGES.md

# Local model copies, backups and fine-tune runs (deployed model is experiments/stgcn/checkpoints/best_checkpoint.pt)
/best_checkpoint.pt
backups/
experiments/stgcn/checkpoints/*_f1bug.pt
experiments/stgcn_user/
experiments/stgcn/train_data/
image.png
*.zip
*.docx

# Personal webcam data (privacy: landmarks of the user's own signing)
experiments/realtime_debug/
data/user_recordings/
data/manifests/user_recordings.csv

# Generated landmark data (231 MB) and logs
data/processed/
logs/

# Tunnel binary and local deploy tools
cloudflared*.exe

# Frontend build output (frontend/public/models IS committed: the website serves those files)
frontend/dist/

# Python ignores lib/ above; the web app keeps code in frontend/src/lib
!frontend/src/lib/
